{
  "name": "hilo3d",
  "version": "2.0.0",
  "description": "A TypeScript-first WebGL 3D engine.",
  "type": "module",
  "main": "./dist/Hilo3d.umd.cjs",
  "module": "./dist/Hilo3d.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/Hilo3d.js",
      "require": "./dist/Hilo3d.umd.cjs"
    }
  },
  "files": [
    "dist/",
    "types/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README_ZH.md"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "examples:dev": "vite --config vite.examples.config.ts --host 0.0.0.0",
    "examples:build": "vite build --config vite.examples.config.ts",
    "examples:test": "jiti scripts/examples-smoke.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint eslint.config.ts vite.config.ts vite.examples.config.ts vitest.config.ts src/Hilo3d.ts src/constants src/core/Class.ts src/core/version.ts src/env.d.ts src/math.ts src/math/index.ts src/math/math.ts src/renderer/logGLResource.ts src/utils/browser.ts src/utils/log.ts src/utils/bufferUtil.ts src/utils/WebGLSupport.ts examples/js/hilo3d.ts examples/js/hilo3d-math.ts examples/js/init.ts examples/js/OrbitControls.ts examples/js/stats.ts examples/js/NormalTangentHelper.ts scripts/examples-smoke.ts test/setup.ts test/globals.d.ts test/types/package.test.ts",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build && npm run examples:build && npm run examples:test",
    "prepublishOnly": "npm run validate"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hiloteam/Hilo3d.git"
  },
  "keywords": [
    "hilo",
    "3d",
    "webgl",
    "typescript"
  ],
  "author": "06wj",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hiloteam/Hilo3d/issues"
  },
  "homepage": "https://hiloteam.github.io/Hilo3d",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "amc": "^1.0.6",
    "gl-matrix": "^3.4.4",
    "parse-hdr": "^1.0.0",
    "ray-3d": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/sinon": "^22.0.0",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^10.6.0",
    "glslify": "^7.1.1",
    "jiti": "^2.7.0",
    "playwright": "^1.61.1",
    "should": "^13.2.3",
    "sinon": "^22.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
