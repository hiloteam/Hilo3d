{
  "name": "hilo3d",
  "version": "2.0.0",
  "description": "A TypeScript-first, WebGL 2-only 3D engine.",
  "type": "module",
  "types": "./dist/Hilo3d.d.ts",
  "exports": {
    ".": {
      "types": "./dist/Hilo3d.d.ts",
      "import": "./dist/Hilo3d.js",
      "default": "./dist/Hilo3d.js"
    },
    "./umd": {
      "import": {
        "types": "./dist/Hilo3d.umd.d.mts",
        "default": "./dist/Hilo3d.js"
      },
      "require": {
        "types": "./dist/Hilo3d.umd.d.cts",
        "default": "./dist/Hilo3d.umd.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README_ZH.md"
  ],
  "scripts": {
    "clean": "rimraf .cache coverage dist dist-examples docs playwright-report reports site test-results",
    "clean:build": "rimraf .cache/types .cache/tsconfig.lib.tsbuildinfo dist",
    "dev": "vite --host 0.0.0.0",
    "examples:dev": "vite --config vite.examples.config.ts --host 0.0.0.0",
    "examples:serve": "vite --config vite.examples.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "examples:build": "vite build --config vite.examples.config.ts",
    "examples:test": "npm run test:ui",
    "build": "npm run clean:build && npm run build:js && npm run build:types",
    "build:js": "vite build --mode library-es && vite build --mode library-umd",
    "build:types": "tsc -p tsconfig.lib.json && jiti scripts/build-types.ts",
    "typecheck": "tsc -b --force --pretty",
    "typecheck:clean": "tsc -b --clean",
    "lint": "npm run build:types && eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:types": "tsc -p test/types/tsconfig.bundler.json && tsc -p test/types/tsconfig.nodenext.json && tsc -p test/types/tsconfig.umd.json",
    "test:package": "npm run build && npm run test:package:built",
    "test:package:built": "publint && attw --pack . --profile esm-only && jiti scripts/test-package.ts",
    "api:update": "npm run build:types && api-extractor run --local",
    "api:check": "npm run build:types && api-extractor run",
    "docs:build": "typedoc",
    "docs:check": "typedoc --emit none",
    "site:build": "npm run docs:build && npm run examples:build && jiti scripts/build-site.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "validate": "npm run clean && npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:types && npm run test:ui && npm run test:visual && npm run examples:build && npm run docs:check && npm run api:check && npm run test:package:built && npm run pack:check",
    "prepack": "npm run build",
    "prepublishOnly": "npm run validate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiloteam/Hilo3d.git"
  },
  "keywords": [
    "hilo",
    "3d",
    "webgl",
    "webgl2",
    "typescript"
  ],
  "author": "06wj",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hiloteam/Hilo3d/issues"
  },
  "homepage": "https://hilo3d.js.org",
  "engines": {
    "node": ">=22.22.2"
  },
  "packageManager": "npm@12.0.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.22.2",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  },
  "dependencies": {
    "gl-matrix": "^3.4.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@loaders.gl/draco": "4.4.3",
    "@microsoft/api-extractor": "^7.58.9",
    "@playwright/test": "^1.61.1",
    "@types/draco3d": "1.4.10",
    "@types/node": "^22.20.1",
    "@types/webxr": "0.5.24",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "cannon-es": "0.20.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.7.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "publint": "^0.3.21",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
