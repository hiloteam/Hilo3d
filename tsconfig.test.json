{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./.cache/tsconfig.test.tsbuildinfo",
    "types": ["node", "vite/client"]
  },
  "include": ["test/**/*.ts", "scripts/npm-pack-result.ts"],
  "exclude": ["test/types/**"],
  "references": [{ "path": "./tsconfig.lib.json" }]
}
