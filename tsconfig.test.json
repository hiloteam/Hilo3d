{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./.cache/tsconfig.test.tsbuildinfo",
    "types": ["node", "vite/client"],
    "paths": {
      "@hilo3d/addon-particle": ["./addon-particle/src/index.ts"],
      "hilo3d": ["./src/Hilo3d.ts"]
    }
  },
  "include": [
    "benchmarks/**/*.ts",
    "examples/shared/catalog.ts",
    "test/**/*.ts",
    "scripts/npm-pack-result.ts",
    "scripts/site-link-references.ts",
    "scripts/shader-modernity.ts",
    "scripts/performance/**/*.ts"
  ],
  "exclude": ["test/types/**"],
  "references": [
    { "path": "./tsconfig.lib.json" },
    { "path": "./addon-particle/tsconfig.json" },
    { "path": "./addon-physics/tsconfig.json" }
  ]
}
