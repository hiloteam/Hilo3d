{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./.cache/tsconfig.test.tsbuildinfo",
    "types": ["node", "vite/client"],
    "paths": {
      "@hilo/addon-particle": ["./addon-particle/src/index.ts"],
      "hilo3d": ["./src/Hilo3d.ts"],
      "@hilo/addon-live2d": ["./addon-live2d/src/index.ts"]
    }
  },
  "include": [
    "benchmarks/**/*.ts",
    "examples/shared/catalog.ts",
    "examples/shared/test-frame-control.ts",
    "examples/physics/materialExperiments.ts",
    "examples/physics/characterExperiment.ts",
    "examples/physics/bridgeExperiment.ts",
    "test/**/*.ts",
    "vite.config.ts",
    "scripts/npm-pack-result.ts",
    "scripts/playwright-test-server.ts",
    "scripts/release-git-tag-core.ts",
    "scripts/site-link-references.ts",
    "scripts/shader-modernity.ts",
    "scripts/performance/**/*.ts",
    "scripts/documentation-content.ts"
  ],
  "exclude": ["test/types/**"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "./addon-particle/tsconfig.json"
    },
    {
      "path": "./addon-physics/tsconfig.json"
    },
    {
      "path": "./addon-live2d/tsconfig.json"
    },
    {
      "path": "./addon-live2d/tsconfig.tools.json"
    }
  ]
}
