{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./.cache/tsconfig.examples.tsbuildinfo",
    "types": ["vite/client", "webxr"],
    "paths": {
      "@hilo/addon-particle": ["./addon-particle/src/index.ts"],
      "@hilo/addon-physics": ["./addon-physics/src/index.ts"],
      "@hilo/addon-physics/rapier2d": ["./addon-physics/src/rapier2d.ts"],
      "@hilo/addon-physics/rapier3d": ["./addon-physics/src/rapier3d.ts"],
      "hilo3d": ["./src/Hilo3d.ts"],
      "@hilo/addon-live2d": ["./addon-live2d/src/index.ts"],
      "@hilo/addon-assets": ["./addon-assets/src/index.ts"]
    }
  },
  "include": ["examples/**/*.ts", "benchmarks/ddgi/fixture-contract.ts"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    },
    {
      "path": "./addon-particle/tsconfig.json"
    },
    {
      "path": "./addon-physics/tsconfig.json"
    },
    {
      "path": "./addon-live2d/tsconfig.json"
    },
    {
      "path": "./addon-assets/tsconfig.json"
    }
  ]
}
