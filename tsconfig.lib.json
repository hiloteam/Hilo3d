{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "outDir": "./.cache/types",
    "tsBuildInfoFile": "./.cache/tsconfig.lib.tsbuildinfo",
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts"]
}
