{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": ".",
    "outDir": ".cache/tools",
    "tsBuildInfoFile": ".cache/tools.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "hilo3d": ["../src/Hilo3d.ts"],
      "@hilo/addon-assets": ["./src/index.ts"]
    },
    "lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"]
  },
  "include": ["tools/**/*.ts", "test/**/*.ts"],
  "references": [
    {
      "path": "../tsconfig.lib.json"
    },
    {
      "path": "./tsconfig.json"
    }
  ]
}
