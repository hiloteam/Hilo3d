{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "mainEntryPointFilePath": "<projectFolder>/dist/Hilo3d.d.ts",
  "compiler": {
    "tsconfigFilePath": "<projectFolder>/tsconfig.lib.json"
  },
  "apiReport": {
    "enabled": true,
    "includeForgottenExports": true,
    "reportFileName": "hilo3d.api.md",
    "reportFolder": "<projectFolder>/etc",
    "reportTempFolder": "<projectFolder>/.cache/api"
  },
  "docModel": {
    "enabled": false
  },
  "dtsRollup": {
    "enabled": false
  },
  "tsdocMetadata": {
    "enabled": false
  },
  "messages": {
    "extractorMessageReporting": {
      "ae-missing-release-tag": {
        "logLevel": "none"
      },
      "ae-setter-with-docs": {
        "logLevel": "none"
      }
    }
  }
}
